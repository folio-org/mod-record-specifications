<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <!--
    Tracks which one-off MARC spec corrections MarcSpecUpdateService has already applied to this
    tenant, so a tenant upgrade only resyncs when there's an update it hasn't seen yet.
    specification_snapshot backs up the full (fields/indicators/subfields/indicator-codes)
    specification for that family/profile as it stood right before the resync that applied this
    update. See docs/marc-spec-corrections.md.
  -->

  <changeSet id="MRSPECS-213@@create-table:applied_spec_update" author="pavlo_smahin">
    <preConditions onFail="MARK_RAN">
      <not>
        <tableExists tableName="applied_spec_update"/>
      </not>
    </preConditions>

    <comment>Create applied_spec_update table</comment>

    <createTable tableName="applied_spec_update">
        <column name="code" type="VARCHAR(50)">
            <constraints nullable="false" primaryKey="true" primaryKeyName="pk_applied_spec_update"/>
        </column>
        <column name="family" type="family_enum">
            <constraints nullable="false" primaryKey="true" primaryKeyName="pk_applied_spec_update"/>
        </column>
        <column name="profile" type="family_profile_enum">
            <constraints nullable="false" primaryKey="true" primaryKeyName="pk_applied_spec_update"/>
        </column>
        <column name="specification_snapshot" type="JSONB">
            <constraints nullable="false"/>
        </column>
        <column name="applied_date" type="DATETIME">
            <constraints nullable="false"/>
        </column>
    </createTable>
  </changeSet>

</databaseChangeLog>
